// Prisma schema for JVM Institute website
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



enum Role {
  USER
  STUDENT
  ADMIN
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentType {
  FULL_COURSE_FEE
  ADVANCE_DEPOSIT
  STUDY_MATERIAL
}

model User {
  id           String             @id @default(cuid())
  name         String?
  email        String             @unique
  phone        String?
  passwordHash String?
  role         Role               @default(USER)
  referralCode String             @unique @default(cuid())
  referredById String?
  referredBy   User?              @relation("UserReferrals", fields: [referredById], references: [id])
  referrals    User[]             @relation("UserReferrals")
  enrollments  Enrollment[]
  purchases    MaterialPurchase[]
  payouts      ReferralPayout[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model Course {
  id               String       @id @default(cuid())
  slug             String       @unique
  title            String
  shortDescription String
  fullDescription  String       @db.Text
  duration         String
  mode             String       @default("Online & Offline")
  fullFee          Float
  advanceFee       Float
  brochurePdfUrl   String?
  isFeatured       Boolean      @default(true)
  enrollments      Enrollment[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Enrollment {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  paymentType   PaymentType
  paymentStatus PaymentStatus @default(PENDING)
  amountPaid    Float
  transactionId String?
  createdAt     DateTime      @default(now())
}

model Event {
  id             String              @id @default(cuid())
  slug           String              @unique
  title          String
  category       String // upcoming, past, hackathon, free
  date           String
  time           String
  mode           String // Virtual, Campus, Hybrid
  speakerName    String
  speakerRole    String
  speakerCompany String
  speakerAvatar  String
  description    String              @db.Text
  tags           String[]
  seatsTotal     Int                 @default(250)
  seatsFilled    Int                 @default(0)
  isFeatured     Boolean             @default(false)
  videoUrl       String?
  githubUrl      String?
  slidesUrl      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  registrations  EventRegistration[]
}

model EventRegistration {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  passId    String   @unique
  name      String
  email     String
  phone     String
  expLevel  String
  createdAt DateTime @default(now())
}

model Placement {
  id          String   @id @default(cuid())
  name        String
  domain      String
  placedRole  String
  company     String
  package     String
  skills      String
  image       String   @default("/place1.png")
  category    String   @default("data_engineering")
  isFeatured  Boolean  @default(true)
  testimonial String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("placements")
}

model BlogPost {
  id                  String   @id @default(cuid())
  slug                String   @unique
  title               String
  metaTitle           String?
  excerpt             String   @db.Text
  longDescriptionHtml String?  @db.Text
  category            String   @default("Data Engineering")
  authorName          String   @default("JVM Technical Team")
  authorRole          String   @default("Senior Data Architect @ JVM")
  authorAvatar        String   @default("/place1.png")
  publishedAt         String   @default("Aug 2026")
  readTime            String   @default("5 min read")
  image               String   @default("/course.jpg")
  tags                String   @default("Data Engineering, Python, SQL")
  featured            Boolean  @default(false)
  contentJson         String   @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("blog_posts")
}

model StudyMaterial {
  id          String             @id @default(cuid())
  slug        String             @unique
  title       String
  description String
  subject     String
  price       Float              @default(0) // 0 means free
  fileUrl     String
  previewUrl  String?
  isFree      Boolean            @default(false)
  purchases   MaterialPurchase[]
  createdAt   DateTime           @default(now())
}

model MaterialPurchase {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  materialId    String
  material      StudyMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  amountPaid    Float
  paymentStatus PaymentStatus @default(PENDING)
  transactionId String?
  createdAt     DateTime      @default(now())
}

model ReferralPayout {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Float
  status    String   @default("PENDING") // PENDING, PAID
  notes     String?
  createdAt DateTime @default(now())
}

model LeadEnquiry {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String
  courseSlug String?
  message    String?  @db.Text
  source     String   @default("WEBSITE_CONTACT")
  isResolved Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Admin {
  id        String   @id @default(cuid())
  fullName  String
  email     String   @unique
  password  String
  role      String   @default("SUPER_ADMIN")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

model StudyMaterialCourse {
  id               String                @id @default(cuid())
  slug             String                @unique
  title            String
  description      String                @db.Text
  subject          String                @default("Data Engineering")
  badge            String?               @default("Popular")
  price            Float                 @default(499)
  freeModulesCount Int                   @default(1)
  coverImage       String?               @default("/course.jpg")
  isPublished      Boolean               @default(true)
  modules          StudyMaterialModule[]
  unlocks          StudyCourseAccess[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@map("study_material_courses")
}

model StudyMaterialModule {
  id           String              @id @default(cuid())
  courseId     String
  course       StudyMaterialCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleNumber Int
  slug         String              @default("")
  title        String
  description  String?             @db.Text
  contentHtml  String              @db.Text
  readTime     String              @default("10 min read")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@map("study_material_modules")
}

model StudyCourseAccess {
  id                String              @id @default(cuid())
  courseId          String
  course            StudyMaterialCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  accessKey         String              // Unique browser key or random uuid
  accessCode        String?             // 6-digit passcode for cross-device restoration
  userEmail         String?             // Customer email
  userPhone         String?             // Customer phone
  razorpayOrderId   String?
  razorpayPaymentId String?
  amountPaid        Float               @default(0)
  createdAt         DateTime            @default(now())

  @@map("study_course_accesses")
}

